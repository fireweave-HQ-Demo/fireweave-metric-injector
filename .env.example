# Copy to .env and generate secrets:
#   openssl rand -base64 32
#   openssl rand -base64 32
#   openssl rand -base64 32

NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://fireweave:fireweave@localhost:5432/fireweave
TEST_DATABASE_URL=postgresql://fireweave:fireweave@localhost:5432/fireweave_test
REDIS_URL=redis://localhost:6379
ENCRYPTION_KEY=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
AUTH_RATE_LIMIT_MAX=5
API_RATE_LIMIT_MAX=100
# Comma-separated. Required when NODE_ENV=production.
CORS_ORIGINS=
WORKER_METRICS_PORT=3001
# Next dev server. The browser talks to this origin; Next proxies to the API.
# API_URL=http://127.0.0.1:3000

# Manual only. `pnpm test:vendor-sandbox` is not part of `pnpm test` or CI.
# SANDBOX_DATADOG_API_KEY=
# SANDBOX_DATADOG_APP_KEY=
# SANDBOX_DATADOG_SITE=datadoghq.com
# SANDBOX_OPENOBSERVE_BASE_URL=
# SANDBOX_OPENOBSERVE_ORG=
# SANDBOX_OPENOBSERVE_TOKEN=
# Live OpenObserve round trip. Not part of `pnpm test` unless all four are set.
# OPENOBSERVE_EMAIL=
# OPENOBSERVE_BASE_URL=https://api.openobserve.ai
# OPENOBSERVE_STAGING_ORG=
# OPENOBSERVE_STAGING_PASSWORD=
# OPENOBSERVE_PRODUCTION_ORG=
# OPENOBSERVE_PRODUCTION_PASSWORD=
# SANDBOX_SENTRY_DSN=
# SANDBOX_SENTRY_ORG=
# SANDBOX_SENTRY_PROJECT=
# SANDBOX_SENTRY_TOKEN=

# Compose Postgres and Redis are the test dependency. Leave this unset.
# USE_TESTCONTAINERS=1
