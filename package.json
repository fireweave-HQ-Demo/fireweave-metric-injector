{
  "name": "fireweave-metric-injector",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "bash scripts/dev.sh start",
    "stop": "bash scripts/dev.sh stop",
    "test": "pnpm --filter @fireweave/db generate && pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @fireweave/db generate",
    "db:migrate": "pnpm --filter @fireweave/db migrate:deploy",
    "db:migrate:dev": "pnpm --filter @fireweave/db migrate:dev",
    "test:vendor-sandbox": "pnpm --filter @fireweave/api exec tsx scripts/vendor-sandbox.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.0",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3"
  }
}
